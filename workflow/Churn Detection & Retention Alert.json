        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst loopData = $('Loop Over Items').item.json;\n\nconst text = item.output[0].content[0].text;\nconst cleaned = text.replace(/[\\r\\n]/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  row_number: loopData.row_number,\n  customer_name: loopData.customer_name,\n  email: loopData.email,\n  plan_type: loopData.plan_type,\n  churn_score: parseInt(parsed.churn_score),\n  risk_action: parsed.risk_action,\n  risk_reason: parsed.risk_reason\n};"
      },
