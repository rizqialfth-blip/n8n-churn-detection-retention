            {
              "content": "=Analyze this customer data and return a churn risk assessment.\n\nCustomer Data:\n- Name: {{ $json.customer_name }}\n- Plan: {{ $json.plan_type }}\n- Subscription Start: {{ $json.subscription_start }}\n- Last Login: {{ $json.last_login }}\n- Support Tickets: {{ $json.support_tickets }}\n- Monthly Usage: {{ $json.monthly_usage }}\n\nRespond ONLY with this exact JSON format, no other text:\n{\n  \"churn_score\": 75,\n  \"risk_action\": \"your recommended action here\",\n  \"risk_reason\": \"one sentence explanation here\"\n}"
            }
          ]
        },
